{
  "name": "rollergirl",
  "private": true,
  "description": "Tooling for the rollergirl game. The game itself needs none of this.",
  "scripts": {
    "bump": "node tools/bump.mjs",
    "check:syntax": "node tools/syntax.mjs index.html",
    "check:boot": "node tools/boot.mjs",
    "check": "npm run check:syntax && npm run check:boot",
    "rig": "node tools/rig.mjs",
    "sim": "node tools/sim.mjs",
    "clips": "node tools/clips.mjs",
    "icons": "node tools/icons.mjs",
    "borrow": "node tools/borrow.mjs",
    "shot": "node tools/shot.mjs",
    "export": "node tools/export.mjs",
    "export:kit": "node tools/export.mjs kit",
    "export:lib": "node tools/export.mjs kit lib",
    "heights": "node tools/heights.mjs",
    "oblique": "node tools/oblique.mjs",
    "rebase": "node tools/rebase.mjs",
    "plan": "node tools/plan.mjs",
    "trace": "node tools/trace.mjs",
    "export:park": "node tools/export.mjs park",
    "wpprops": "node tools/wpprops.mjs"
  },
  "type": "module",
  "devDependencies": {
    "sharp": "^0.35.5"
  }
